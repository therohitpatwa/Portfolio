---
import { Icon } from "astro-icon/components";
import * as about from "../pages/about/about.md";
import NavBar from "./NavBar.astro";
---

<header class="w-full mb-8">
  <NavBar />
  
  <!-- Spacer to prevent content from jumping under the fixed nav -->
  <div class="h-16 mb-4"></div>

  <article class="flex flex-row items-center gap-6 w-full">
    <div
      class="flex-shrink-0 w-24 h-24 md:w-32 md:h-32 rounded-full shadow-sm overflow-hidden border-2 border-transparent"
    >
      <img
        alt="Rohit Patwa - Full Stack Developer Profile Picture"
        src="/profile.webp"
        class="grayscale-[20] hover:grayscale-0 w-full h-full object-cover"
        width="128"
        height="128"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="flex flex-col text-left">
      <div class="flex items-center gap-3 mb-2">
        <h1
          class="text-3xl md:text-5xl font-medium tracking-tight"
          style="font-family: 'Cinzel', serif;"
        >
          {about.frontmatter.name}
        </h1>
      </div>
      <div class="flex items-center flex-wrap text-sm md:text-lg text-secondary gap-2 font-medium">
        <span>An Engineer</span>
        <span>&middot;</span>
        <span class="flex items-center gap-2">
          <span>therohitpatwa@gmail.com</span>
          <button id="copy-email-btn" class="flex items-center justify-center rounded cursor-pointer hover:text-primary transition-colors p-1 -ml-1" aria-label="Copy email address" title="Copy email address">
            <Icon name="carbon:copy" id="copy-icon" class="w-4 h-4 block" />
            <Icon name="carbon:checkmark" id="check-icon" class="w-4 h-4 hidden text-base-content" />
          </button>
        </span>
      </div>
    </div>
  </article>
</header>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");

  if (copyBtn && copyIcon && checkIcon) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText("therohitpatwa@gmail.com").then(() => {
        copyIcon.classList.remove("block");
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");
        checkIcon.classList.add("block");

        setTimeout(() => {
          checkIcon.classList.remove("block");
          checkIcon.classList.add("hidden");
          copyIcon.classList.remove("hidden");
          copyIcon.classList.add("block");
        }, 2000);
      });
    });
  }
</script>
