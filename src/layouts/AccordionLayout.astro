---
import { Icon } from "astro-icon/components";
const { title, icon, accordionId } = Astro.props;
const id = accordionId || title.toLowerCase().replace(/\s+/g, "-");
---

<div
  class="collapse accordion-item"
  data-accordion-id={id}
>
  <input
    aria-label={title}
    type="checkbox"
    id={id}
    class="accordion-checkbox"
  />
  <div
    class="collapse-title font-extrabold tracking-tight md:text-2xl"
    style="font-family: 'Cinzel', serif;"
  >
    <div class="flex">
      <Icon name={icon} class="w-8 h-8 mr-4" />
      {title}
    </div>
  </div>
  <div class="collapse-content">
    <slot />
  </div>
</div>

<style>
  /* Force accordion open on desktop immediately to prevent flash of closed state */
  @media (min-width: 768px) {
    .accordion-item.collapse {
      overflow: visible;
      grid-template-rows: auto 1fr !important;
    }
    .accordion-item.collapse > .collapse-content {
      visibility: visible !important;
      opacity: 1 !important;
      padding-bottom: 1rem !important;
    }
    .accordion-item.collapse > .accordion-checkbox {
      pointer-events: none;
    }
    .accordion-item.collapse > .collapse-title {
      cursor: default;
    }
  }
</style>
